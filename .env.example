# Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
VITE_GOOGLE_ANALYTICS_ID='blah'

# Google Maps JavaScript API key
VITE_GOOGLE_MAPS_API_KEY='blah'

# Stripe publishable key (pk_test_... / pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY='blah'

# Base URL of the food-facts-friends API (no trailing slash)
VITE_FFF_API_BASE_URL='http://localhost:3000'

# Dev only: set to 'true' to always show the cookie banner on load,
# ignoring stored consent. Has no effect in production builds.
VITE_FORCE_COOKIE_BANNER='false'
